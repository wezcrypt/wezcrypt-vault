# Copy to .env and edit. Never commit the real .env.
# Host port the SFTP server listens on (use 22 if nothing else uses it).
SFTP_PORT=2222
# The PUBLIC key line of the key pair you select in WezCrypt Vault (contents of id_ed25519.pub).
# Never put a private key here.
STORAGE_AUTHORIZED_KEY=ssh-ed25519 REPLACE_WITH_YOUR_PUBLIC_KEY wezcrypt-vault
